# Copy this file to .env and fill in your real values
# NEVER commit .env to git — it's already in .gitignore

# --- Firebase ---
# Get these from: https://console.firebase.google.com → your project → Project Settings → Your apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Spotify (scripts only — never exposed to the browser) ---
# Get these from: https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
