# Copy this file to .env and fill in your real values
# NEVER commit .env to git — it's already in .gitignore

# --- Firebase ---
# Get these from: https://console.firebase.google.com → your project → Project Settings → Your apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Spotify ---
# Get a token from: https://developer.spotify.com/dashboard
# 1. Create an app → go to your app → Settings → copy Client ID and Secret
# 2. Use the "Get Token" button in the dashboard for a quick manual token
# Note: tokens expire after 1 hour
VITE_SPOTIFY_TOKEN=your_spotify_bearer_token_here
